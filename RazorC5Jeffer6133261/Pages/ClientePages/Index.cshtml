<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Sistema de Gestión - Razor Pages</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
            .bg-gradient-primary {
                background: linear-gradient(180deg, #4e73df 10%, #224abe 100%);
            }

            .sidebar {
                min-height: 100vh;
                width: 280px;
                position: fixed;
                top: 0;
                left: 0;
                z-index: 100;
                background: linear-gradient(180deg, #4e73df 10%, #224abe 100%);
            }

                .sidebar .nav-item {
                    width: 100%;
                }

                .sidebar .nav-link {
                    color: rgba(255,255,255,0.8);
                    padding: 0.6rem 1rem;
                    display: block;
                    text-decoration: none;
                    transition: all 0.3s;
                    font-size: 0.9rem;
                }

                    .sidebar .nav-link:hover {
                        background-color: rgba(255,255,255,0.1);
                        color: white;
                    }

                    .sidebar .nav-link i {
                        width: 25px;
                        margin-right: 10px;
                    }

            .sidebar-brand {
                height: 4rem;
                color: white;
                text-decoration: none;
                font-weight: bold;
                font-size: 1.2rem;
                display: flex;
                align-items: center;
                justify-content: center;
                border-bottom: 1px solid rgba(255,255,255,0.2);
            }

            #content-wrapper {
                margin-left: 280px;
                padding: 1rem;
            }

            .sidebar-divider {
                border-color: rgba(255,255,255,0.2);
                margin: 0.5rem 0;
            }

            .nav-group-title {
                color: rgba(255,255,255,0.5);
                font-size: 0.7rem;
                padding: 0.5rem 1rem;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .nav-child {
                padding-left: 2rem;
            }
    </style>
</head>
<body id="page-top">

    <div class="sidebar">
        <div class="sidebar-brand">
            Dashboard - Sistema de Gestión
        </div>

        <hr class="sidebar-divider">

        <nav class="nav flex-column">
            <a class="nav-link" asp-page="/Index">
                <i class="fas fa-fw fa-home"></i>
                <span>Inicio</span>
            </a>

            <hr class="sidebar-divider">

            <div class="nav-group-title">
                <i class="fas fa-fw fa-user me-1"></i> Clientes
            </div>
            <a class="nav-link nav-child" asp-page="/ClientePages/Index">
                <i class="fas fa-fw fa-list"></i>
                <span>Listar Clientes</span>
            </a>
            <a class="nav-link nav-child" asp-page="/ClientePages/Create">
                <i class="fas fa-fw fa-plus"></i>
                <span>Nuevo Cliente</span>
            </a>

            <hr class="sidebar-divider">

            <div class="nav-group-title">
                <i class="fas fa-fw fa-building"></i> Oficinas
            </div>
            <a class="nav-link nav-child" asp-page="/OficinaPages/Index">
                <i class="fas fa-fw fa-list"></i>
                <span>Listar Oficinas</span>
            </a>
            <a class="nav-link nav-child" asp-page="/OficinaPages/Create">
                <i class="fas fa-fw fa-plus"></i>
                <span>Nueva Oficina</span>
            </a>

            <hr class="sidebar-divider">

            <div class="nav-group-title">
                <i class="fas fa-fw fa-users"></i> Empleados
            </div>
            <a class="nav-link nav-child" asp-page="/EmpleadoPages/Index">
                <i class="fas fa-fw fa-list"></i>
                <span>Listar Empleados</span>
            </a>
            <a class="nav-link nav-child" asp-page="/EmpleadoPages/Create">
                <i class="fas fa-fw fa-plus"></i>
                <span>Nuevo Empleado</span>
            </a>

            <hr class="sidebar-divider">

            <div class="nav-group-title">
                <i class="fas fa-fw fa-calculator"></i> Contables
            </div>
            <a class="nav-link nav-child" asp-page="/EmpleadoContablePages/Index">
                <i class="fas fa-fw fa-list"></i>
                <span>Listar Contables</span>
            </a>
            <a class="nav-link nav-child" asp-page="/EmpleadoContablePages/Create">
                <i class="fas fa-fw fa-plus"></i>
                <span>Nuevo Contable</span>
            </a>

            <hr class="sidebar-divider">

            <div class="nav-group-title">
                <i class="fas fa-fw fa-code"></i> Developers
            </div>
            <a class="nav-link nav-child" asp-page="/EmpleadoDeveloperPages/Index">
                <i class="fas fa-fw fa-list"></i>
                <span>Listar Developers</span>
            </a>
            <a class="nav-link nav-child" asp-page="/EmpleadoDeveloperPages/Create">
                <i class="fas fa-fw fa-plus"></i>
                <span>Nuevo Developer</span>
            </a>
        </nav>
    </div>

    <div id="content-wrapper">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>