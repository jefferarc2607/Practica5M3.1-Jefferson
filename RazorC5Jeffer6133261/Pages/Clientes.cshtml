@page
@model RazorC3Jeffer6133261.Pages.ClientesModel
@{
}

<h1>Listado de Clientes</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Nombre del Cliente</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cliente in Model.Clientes)
        {
            <tr>
                <td>@cliente</td>
            </tr>
        }
    </tbody>
</table>