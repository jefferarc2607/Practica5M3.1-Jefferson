@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-4">Bienvenido al gestor Razor</h1>
    <p>Sistema de gestión de empleados y oficinas</p>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h3>Oficinas</h3>
            </div>
            <div class="card-body">
                <p>Gestión de oficinas de la empresa</p>
                <a asp-page="/Oficinas" class="btn btn-primary">Ver Oficinas</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h3>Empleados</h3>
            </div>
            <div class="card-body">
                <p>Gestión de empleados por sector</p>
                <a asp-page="/Empleados/Index" class="btn btn-success">Ver Empleados</a>
            </div>
        </div>
    </div>
</div>
