@page
@model C3P66Jeffer6133261.Pages.Empleados.ContabilidadModel
@{
    ViewData["Title"] = "Empleados de Contabilidad";
}
<h1>Sector Contabilidad</h1>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-page="/Empleados/Index">Empleados</a></li>
        <li class="breadcrumb-item active" aria-current="page">Contabilidad</li>
    </ol>
</nav>

<div class="container">
    <div class="alert alert-success">
        <h1>Empleados del sector contabilidad</h1>
    </div>
</div>

<div class="card">
    <div class="card-header bg-success text-white">
        <h3>Listado de Contables</h3>
    </div>
    <div class="card-body">
        <table class="table table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Edad</th>
                    <th>Email</th>
                    <th>Registros Creados</th>
                    <th>Facturas Procesadas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contable in Model.EmpleadosContables)
                {
                    <tr>
                        <td>@contable.Id</td>
                        <td>@contable.Nombre</td>
                        <td>@contable.Edad</td>
                        <td>@contable.Email</td>
                        <td>@contable.RegistrosCreados</td>
                        <td>@contable.FacturasProcesadas</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-page="/Empleados/Index" class="btn btn-secondary">Volver a Empleados</a>
</div>