@page
@model C3P66Jeffer6133261.Pages.OficinasModel
@{
    ViewData["Title"] = "Oficinas";
    Layout = "_Layout";
}
<h1>Oficinas de la empresa</h1>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Oficinas</li>
    </ol>
</nav>

<div class="alert alert-primary">
    <h3>Mostrando oficina número @Model.id</h3>
</div>

<div class="card">
    <div class="card-header bg-info text-white">
        <h3>Listado de Oficinas</h3>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Ubicación</th>
                    <th>Capacidad</th>
                    <th>Atención al público</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var oficina in Model.Oficinas)
                {
                    <tr>
                        <td>@oficina.Id</td>
                        <td>@oficina.Ubicacion</td>
                        <td>@oficina.Capacidad</td>
                        <td>@(oficina.AtencionPublico ? "Sí" : "No")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-page="/Index" class="btn btn-secondary">Volver al Inicio</a>
</div>
