<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Sistema de Gestión Razor</title>  
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- tuve problemas con el bootstrap asi que añadi un estilo personalizado -->
    <style>
            .bg-gradient-primary {
                background: linear-gradient(180deg, #4e73df 10%, #224abe 100%);
            }

            .sidebar {
                min-height: 100vh;
                width: 250px;
                position: fixed;
                top: 0;
                left: 0;
                z-index: 100;
            }

                .sidebar .nav-item {
                    width: 100%;
                }

                .sidebar .nav-link {
                    color: rgba(255,255,255,0.8);
                    padding: 1rem;
                    display: block;
                    text-decoration: none;
                }

                    .sidebar .nav-link:hover {
                        color: white;
                        background-color: rgba(255,255,255,0.1);
                    }

            .sidebar-brand {
                height: 4rem;
                color: white;
                text-decoration: none;
                font-weight: bold;
                font-size: 1.2rem;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            #content-wrapper {
                margin-left: 250px;
                padding: 1rem;
            }

            .sidebar-divider {
                border-color: rgba(255,255,255,0.2);
                margin: 0.5rem 0;
            }
    </style>
</head>
<body id="page-top">
    <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">

        <a class="sidebar-brand d-flex align-items-center justify-content-center" asp-page="/Index">
            <div class="sidebar-brand-text mx-3">DASHBOARD</div>
        </a>

        <hr class="sidebar-divider my-0">

        <li class="nav-item active">
            <a class="nav-link" asp-page="/Index">
                <i class="fas fa-fw fa-tachometer-alt"></i>
                <span>Gestion - Razor</span>
            </a>
        </li>

        <hr class="sidebar-divider">

        <li class="nav-item">
            <a class="nav-link" asp-page="/Oficinas">
                <i class="fas fa-fw fa-table"></i>
                <span>Oficinas</span>
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" asp-page="/Empleados/Index">
                <i class="fas fa-fw fa-chart-area"></i>
                <span>Empleados</span>
            </a>
        </li>
    </ul>
    <div id="content-wrapper" class="d-flex flex-column">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>